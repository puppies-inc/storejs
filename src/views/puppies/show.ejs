<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StoreJS — <%= puppy.name %></title>
    <%- include('../partials/theme') %>
  </head>
  <body>
    <div class="nav">
      <a href="/puppies" class="btn">← Puppies</a>
      <%- include('../partials/theme-toggle') %>
    </div>

    <% if (notice) { %>
      <div class="notice"><%= notice %></div>
    <% } %>

    <h1>🐶 <%= puppy.name %></h1>

    <img class="puppy-photo" src="https://placedog.net/640/480?id=<%= puppy.id %>" alt="A random puppy" />

    <p>🐕 Name: <%= puppy.name %></p>

    <p>
      <a href="/puppies/<%= puppy.id %>/edit" class="btn">Edit</a>
    </p>

    <form action="/puppies/<%= puppy.id %>/delete" method="post" style="margin-top: 24px;">
      <button type="submit" class="btn-danger">Delete</button>
    </form>
  </body>
</html>
