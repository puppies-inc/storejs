<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StoreJS — <%= puppy.name %></title>
    <%- include('../partials/theme') %>
  </head>
  <body>
    <div class="nav">
      <a href="/puppies" class="btn">← Puppies</a>
      <%- include('../partials/theme-toggle') %>
    </div>

    <% if (notice) { %>
      <div class="notice"><%= notice %></div>
    <% } %>

    <h1>🐶 <%= puppy.name %></h1>

    <img class="puppy-photo" src="https://placedog.net/640/480?id=<%= puppy.id %>" alt="A random puppy" />

    <p>🐕 Name: <%= puppy.name %></p>

    <p>
      <a href="/puppies/<%= puppy.id %>/edit" class="btn">Edit</a>
    </p>

    <form id="delete-puppy-form" action="/puppies/<%= puppy.id %>/delete" method="post" style="margin-top: 24px;">
      <button type="submit" class="btn-danger" id="delete-puppy-button">Delete</button>
    </form>

    <div id="delete-puppy-modal" class="modal" hidden>
      <div class="modal-backdrop" data-modal-dismiss></div>
      <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-puppy-modal-title">
        <h2 id="delete-puppy-modal-title">Delete puppy?</h2>
        <p>Are you sure you want to delete <%= puppy.name %>? This cannot be undone.</p>
        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="delete-puppy-cancel">Cancel</button>
          <button type="button" class="btn-danger" id="delete-puppy-confirm">Delete</button>
        </div>
      </div>
    </div>

    <script>
      (function () {
        var form = document.getElementById("delete-puppy-form");
        var modal = document.getElementById("delete-puppy-modal");
        var cancelButton = document.getElementById("delete-puppy-cancel");
        var confirmButton = document.getElementById("delete-puppy-confirm");
        var confirmed = false;

        if (!form || !modal) return;

        function openModal() {
          modal.hidden = false;
          confirmButton.focus();
        }

        function closeModal() {
          modal.hidden = true;
        }

        form.addEventListener("submit", function (event) {
          if (confirmed) return;
          event.preventDefault();
          openModal();
        });

        cancelButton.addEventListener("click", closeModal);
        modal.querySelector("[data-modal-dismiss]").addEventListener("click", closeModal);

        confirmButton.addEventListener("click", function () {
          confirmed = true;
          closeModal();
          form.submit();
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && !modal.hidden) closeModal();
        });
      })();
    </script>
  </body>
</html>
