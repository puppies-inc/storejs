<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StoreJS — Puppies</title>
    <%- include('../partials/theme') %>
  </head>
  <body>
    <div class="nav">
      <a href="/puppies" class="btn">🐶 Puppies</a>
      <a href="/puppies/new" class="btn">+ New puppy</a>
      <a href="/about">About</a>
      <%- include('../partials/theme-toggle') %>
    </div>

    <% if (notice) { %>
      <div class="notice"><%= notice %></div>
    <% } %>

    <h1>🐶 Puppies</h1>

    <img class="puppy-photo" src="https://placedog.net/640/480" alt="A random puppy" />

    <% if (puppies.length === 0) { %>
      <p class="empty">No puppies yet. Adopt your first furry friend! 🐾</p>
    <% } %>

    <ul>
      <% puppies.forEach(function(puppy) { %>
        <li>
          <span>🐕 Name: <%= puppy.name %></span>
          <a href="/puppies/<%= puppy.id %>" class="btn">View →</a>
        </li>
      <% }) %>
    </ul>
  </body>
</html>
